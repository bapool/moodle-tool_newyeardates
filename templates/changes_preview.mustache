{{!
    @template tool_newyeardates/changes_preview

    Changes preview template.

    Context variables required for this template:
    * activities - Array of activity changes
    * courseid - Course ID
    * newstartdate - New start date string
    * sesskey - Session key
    * hasactivities - Boolean if activities exist
    * cancelurl - Cancel URL

    Example context (json):
    {
        "activities": [
            {
                "displayname": "Assignment 1 (duedate)",
                "olddate": "Monday, 1 September 2025",
                "newdate": "Monday, 1 September 2026"
            }
        ],
        "courseid": 123,
        "newstartdate": "2026-09-01",
        "sesskey": "abcdef123456",
        "hasactivities": true,
        "cancelurl": "http://example.com/course/view.php?id=123"
    }
}}

<div class="tool-newyeardates-preview">
    <h3>{{#str}}changessummary, tool_newyeardates{{/str}}</h3>

    {{#hasactivities}}
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>{{#str}}activityname, tool_newyeardates{{/str}}</th>
                    <th>{{#str}}currentdate, tool_newyeardates{{/str}}</th>
                    <th>{{#str}}newdate, tool_newyeardates{{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#activities}}
                <tr>
                    <td>{{displayname}}</td>
                    <td>{{olddate}}</td>
                    <td>{{newdate}}</td>
                </tr>
                {{/activities}}
            </tbody>
        </table>
    </div>

    <form method="post" action="" class="mt-3">
        <input type="hidden" name="id" value="{{courseid}}">
        <input type="hidden" name="newstartdate" value="{{newstartdate}}">
        <input type="hidden" name="confirm" value="1">
        <input type="hidden" name="apply" value="1">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        
        <button type="submit" class="btn btn-primary">
            {{#str}}confirmchanges, tool_newyeardates{{/str}}
        </button>
        <a href="{{cancelurl}}" class="btn btn-secondary">
            {{#str}}cancel{{/str}}
        </a>
    </form>
    {{/hasactivities}}
</div>
